<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS: without this string WKWebView won't expose navigator.mediaDevices,
	     so mic capture (voice enroll/verify + "Hey Jarvis") is unavailable. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Jarvis uses the microphone for voice control and "Hey Jarvis".</string>
</dict>
</plist>
