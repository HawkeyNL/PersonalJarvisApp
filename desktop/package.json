{
  "name": "jarvis-app",
  "private": true,
  "version": "0.1.29",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "vue-tsc --noEmit && vite build",
    "build": "npm run check",
    "preview": "vite preview",
    "setup-wakeword": "bash scripts/setup-wakeword.sh",
    "desktop:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:build": "tauri build",
    "desktop:check:native": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "desktop:test:native": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "test:unit": "node --test tests/*.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2",
    "chart.js": "^4.6.1",
    "markdown-it": "^14.3.2",
    "onnxruntime-web": "^1.31.1",
    "pinia": "^2.2.0",
    "vue": "^3.5.45",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.6.2",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  }
}
