<?xml version="1.0" encoding="utf-8"?>
<!-- Keystore-bound ciphertext is useless on another phone: never back it up or transfer it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="jarvis_device_key.xml" />
        <exclude domain="sharedpref" path="jarvis_secure_ciphertext.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="jarvis_device_key.xml" />
        <exclude domain="sharedpref" path="jarvis_secure_ciphertext.xml" />
    </device-transfer>
</data-extraction-rules>
